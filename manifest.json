{
  "manifest_version": 3,
  "name": "모드 업데이트 도우미",
  "version": "0.7.4",
  "minimum_chrome_version": "111",
  "description": "설치된 모드의 새 버전을 확인하고 파일 검증, 백업, 업데이트와 롤백을 지원합니다.",
  "permissions": [
    "storage",
    "scripting",
    "nativeMessaging",
    "alarms"
  ],
  "key": "",
  "host_permissions": [
    "file:///*",
    "https://kone.gg/*",
    "https://api.kio.ac/*",
    "https://dalet.mittere.io/*"
  ],
  "background": {
    "service_worker": "worker.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "모드 업데이트 확인"
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*"
      ],
      "js": [
        "wml-reader.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "file:///*"
      ],
      "js": [
        "game-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
